#!/usr/bin/env bash
# Everything CI runs, in one command. Grows phase by phase (plan §7.7).
set -euo pipefail

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
cd "$ROOT"

oracle_required() {
  [ "${HYPA_TTFX_ORACLE:-}" = "1" ]
}

oracle_available() {
  if oracle_required; then
    [ -x "$ROOT/reference/ttfx" ]
    return
  fi
  if [ -x "$ROOT/reference/ttfx" ] && [ "${HYPA_TTFX_ORACLE:-}" != "0" ]; then
    return 0
  fi
  return 1
}

run_new_oracle_scripts() {
  "$ROOT/tools/parity/random_effect.sh"
  "$ROOT/tools/parity/rebuild_after.sh"
  "$ROOT/tools/parity/ansi_corpus.sh"
}

run_oracle_parity() {
  "$ROOT/tools/parity/waves.sh"
  "$ROOT/tools/parity/unstable.sh"
  "$ROOT/tools/parity/sweep.sh"
  "$ROOT/tools/parity/swarm.sh"
  "$ROOT/tools/parity/spotlights.sh"
  "$ROOT/tools/parity/rings.sh"
  "$ROOT/tools/parity/print.sh"
  "$ROOT/tools/parity/overflow.sh"
  "$ROOT/tools/parity/orbittingvolley.sh"
  "$ROOT/tools/parity/laseretch.sh"
  "$ROOT/tools/parity/highlight.sh"
  "$ROOT/tools/parity/fireworks.sh"
  "$ROOT/tools/parity/decrypt.sh"
  "$ROOT/tools/parity/crumble.sh"
  "$ROOT/tools/parity/colorshift.sh"
  "$ROOT/tools/parity/burn.sh"
  "$ROOT/tools/parity/bubbles.sh"
  "$ROOT/tools/parity/blackhole.sh"
  "$ROOT/tools/parity/binarypath.sh"
  "$ROOT/tools/parity/beams.sh"
  "$ROOT/tools/parity/wipe.sh"
  "$ROOT/tools/parity/bouncyballs.sh"
  "$ROOT/tools/parity/errorcorrect.sh"
  "$ROOT/tools/parity/expand.sh"
  "$ROOT/tools/parity/matrix.sh"
  "$ROOT/tools/parity/middleout.sh"
  "$ROOT/tools/parity/pour.sh"
  "$ROOT/tools/parity/rain.sh"
  "$ROOT/tools/parity/randomsequence.sh"
  "$ROOT/tools/parity/scattered.sh"
  "$ROOT/tools/parity/smoke.sh"
  "$ROOT/tools/parity/slice.sh"
  "$ROOT/tools/parity/slide.sh"
  "$ROOT/tools/parity/synthgrid.sh"
  "$ROOT/tools/parity/thunderstorm.sh"
  "$ROOT/tools/parity/vhstape.sh"
  "$ROOT/tools/parity/spray.sh"
  "$ROOT/tools/parity/tty_compare.sh"
}

"$ROOT/tools/check-prereqs.sh"

if grep -R --include='*.csproj' -n 'PackageReference' .; then
  echo "PackageReference is forbidden; zero NuGet packages are allowed" >&2
  exit 1
fi

if grep -R -nE 'GetType\s*\(|GetProperties\s*\(|GetMethod\s*\(|\.Invoke\s*\(' src/Ttfx/Cli; then
  echo "reflection is forbidden in src/Ttfx/Cli" >&2
  exit 1
fi

python3 - "$ROOT" <<'PY'
import re
import sys
from pathlib import Path

root = Path(sys.argv[1])
comment = re.compile(r"^\s*(///|//)")
to_case = re.compile(r"\.To(Lower|Upper)\s*\(")
to_case_ok = re.compile(r"To(Lower|Upper)Invariant")
starts = re.compile(r"\.(StartsWith|EndsWith|IndexOf)\s*\(")
starts_char = re.compile(r"\.(StartsWith|EndsWith|IndexOf)\s*\(\s*'")
ordinal = re.compile(r"StringComparison\.(Ordinal|OrdinalIgnoreCase)")
parse = re.compile(
    r"\b(?:int|long|double|float|decimal|byte|short|uint|ulong|sbyte|ushort|DateTime)\.(TryParse|Parse)\s*\("
)
parse_ok = re.compile(r"InvariantCulture|NumberStyles")

hits = []
for path in sorted((root / "src").rglob("*.cs")):
    lines = path.read_text(encoding="utf-8").splitlines()
    for i, line in enumerate(lines):
        if comment.match(line):
            continue
        if to_case.search(line) and not to_case_ok.search(line):
            hits.append(f"{path.relative_to(root)}:{i + 1}:{line.rstrip()}")
            continue
        if starts.search(line) and not starts_char.search(line) and not ordinal.search(line):
            hits.append(f"{path.relative_to(root)}:{i + 1}:{line.rstrip()}")
            continue
        if parse.search(line):
            stmt = [line]
            j = i + 1
            while j < len(lines) and ";" not in "".join(stmt):
                stmt.append(lines[j])
                j += 1
            if not parse_ok.search("\n".join(stmt)):
                hits.append(f"{path.relative_to(root)}:{i + 1}:{line.rstrip()}")

if hits:
    print("culture-sensitive Parse/ToLower/StartsWith (use Invariant/Ordinal/NumberStyles):", file=sys.stderr)
    print("\n".join(hits), file=sys.stderr)
    sys.exit(1)
PY

python3 - "$ROOT" <<'PY'
import re
import sys
from pathlib import Path

root = Path(sys.argv[1])

SITES = [
    ("src/Ttfx/Utils/Easing.cs", ("SequenceEaser", "eased_value"), "TruncToUsize|TruncToI64"),
    ("src/Ttfx/Utils/Graphics.cs", ("ShiftColorTowards",), "TruncToI64"),
    ("src/Ttfx/Utils/Geometry.cs", ("FindCoordsInCircle",), "TruncToI64"),
    ("src/Ttfx/Effects/Colorshift.cs", ("direction_index", "ColorShift"), "TruncToI64"),
    ("src/Ttfx/Effects/ColorShift.cs", ("direction_index", "ColorShift"), "TruncToI64"),
    ("src/Ttfx/Effects/OrbittingVolley.cs", ("parent_progress", "volley_size", "ParentProgress"), "TruncToI64"),
    ("src/Ttfx/Effects/Matrix.cs", ("characters.len", "0.1"), "TruncToI64"),
    ("src/Ttfx/Effects/BinaryPath.cs", ("active_binary_groups", "0.2"), "TruncToI64"),
    ("src/Ttfx/Effects/Spotlights.cs", ("smallest_dimension", "SmallestDimension"), "TruncToI64"),
    ("src/Ttfx/Effects/BouncyBalls.cs", ("uniform(1.0, 1.5)", "Uniform(1.0, 1.5)"), "TruncToI64"),
    ("src/Ttfx/Effects/RandomSequence.cs", ("speed * input_len", "input_len"), "TruncToI64"),
    ("src/Ttfx/Effects/Spray.cs", ("spray_volume", "SprayVolume"), "TruncToI64"),
    ("src/Ttfx/Effects/ErrorCorrect.cs", ("error_pairs", "ErrorPairs"), "TruncToI64"),
    ("src/Ttfx/Effects/Fireworks.cs", ("launch_delay", "LaunchDelay"), "TruncToI64"),
]

hits = []
for rel, markers, require in SITES:
    path = root / rel
    if not path.is_file():
        continue
    text = path.read_text(encoding="utf-8")
    if not any(m in text for m in markers):
        continue
    if re.search(require, text) is None:
        hits.append(f"{rel}: translated checklist §1 site must use {require}")

if hits:
    print("checklist §1 TruncToI64 missing:", file=sys.stderr)
    print("\n".join(hits), file=sys.stderr)
    sys.exit(1)
PY

python3 - "$ROOT" <<'PY'
import re
import sys
from pathlib import Path

root = Path(sys.argv[1])
self_mul = re.compile(r"\b([A-Za-z_]\w*)\s*\*\s*\1\b")
comment = re.compile(r"^\s*(///|//)")
hits = []

easing = root / "src/Ttfx/Utils/Easing.cs"
geometry = root / "src/Ttfx/Utils/Geometry.cs"
for path in (easing, geometry):
    if not path.is_file():
        hits.append(f"{path.relative_to(root)}: missing")
        continue
    text = path.read_text(encoding="utf-8")
    for i, line in enumerate(text.splitlines(), 1):
        if comment.match(line):
            continue
        if self_mul.search(line):
            hits.append(f"{path.relative_to(root)}:{i}: x*x standing in for powf(2): {line.rstrip()}")

if geometry.is_file():
    gtext = geometry.read_text(encoding="utf-8")
    if "Math.Pow" not in gtext:
        hits.append("src/Ttfx/Utils/Geometry.cs: must use Math.Pow for powf")
    if "Hypot" not in gtext:
        hits.append("src/Ttfx/Utils/Geometry.cs: must use double.Hypot")
    for i, line in enumerate(gtext.splitlines(), 1):
        if comment.match(line):
            continue
        if "Math.Sqrt" in line:
            hits.append(f"src/Ttfx/Utils/Geometry.cs:{i}: Math.Sqrt standing in for powf(0.5): {line.rstrip()}")

if easing.is_file():
    etext = easing.read_text(encoding="utf-8")
    if etext.count("Math.Pow") < 30:
        hits.append("src/Ttfx/Utils/Easing.cs: too few Math.Pow calls (powf transcription)")
    for i, line in enumerate(etext.splitlines(), 1):
        if comment.match(line):
            continue
        if "Math.Sqrt" in line and "Circ" not in line:
            hits.append(f"src/Ttfx/Utils/Easing.cs:{i}: Math.Sqrt only allowed on Circ .sqrt() lines: {line.rstrip()}")

if hits:
    print("checklist §2 powf/hypot substitution:", file=sys.stderr)
    print("\n".join(hits), file=sys.stderr)
    sys.exit(1)
PY

"$ROOT/bin/build"

dotnet run --project tests/Ttfx.Tests -c Release --no-launch-profile

"$ROOT/tools/tests/cli_corpus.sh"

python3 "$ROOT/tools/tests/sigterm_behavior.py" "$ROOT/artifacts/ttfx"
python3 "$ROOT/tools/tests/sigint_behavior.py" "$ROOT/artifacts/ttfx"
python3 "$ROOT/tools/tests/resize_behavior.py" "$ROOT/artifacts/ttfx"

if oracle_required && [ ! -x "$ROOT/reference/ttfx" ]; then
  echo "bin/test: HYPA_TTFX_ORACLE=1 but $ROOT/reference/ttfx is missing (run tools/parity/fetch_reference.sh)" >&2
  exit 1
fi

if [ "$(uname -s)" = "Linux" ]; then
  "$ROOT/tools/parity/fetch_reference.sh"
  run_new_oracle_scripts
  "$ROOT/tools/parity/m0_matrix.sh"
  "$ROOT/tools/parity/run_suite.sh"
  "$ROOT/tools/parity/tty_compare.sh"
elif oracle_available; then
  echo "bin/test: running local oracle parity (reference/ttfx present)" >&2
  run_new_oracle_scripts
  run_oracle_parity
else
  echo "bin/test: skipping oracle parity (no reference/ttfx; set HYPA_TTFX_ORACLE=1 to require)" >&2
fi
