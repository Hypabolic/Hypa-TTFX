#!/usr/bin/env bash
# Everything CI runs, in one command. Grows phase by phase (plan §7.7).
set -euo pipefail

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
cd "$ROOT"

"$ROOT/tools/check-prereqs.sh"

if grep -R --include='*.csproj' -n 'PackageReference' .; then
  echo "PackageReference is forbidden; zero NuGet packages are allowed" >&2
  exit 1
fi

if grep -R -nE 'GetType\s*\(|GetProperties\s*\(|GetMethod\s*\(|\.Invoke\s*\(' src/Ttfx/Cli; then
  echo "reflection is forbidden in src/Ttfx/Cli" >&2
  exit 1
fi

# Bare culture-sensitive Parse / ToLower / StartsWith (and EndsWith / IndexOf)
# in src/. Allowlist: ToLowerInvariant / ToUpperInvariant, StringComparison.Ordinal*,
# CultureInfo.InvariantCulture, NumberStyles, and char-overload StartsWith/EndsWith/IndexOf('x').
# Comment-only lines are skipped. Custom Parse methods (CliParser.Parse, EasingParse.Parse)
# are not BCL numeric Parse and are not matched. Multiline TryParse(..., NumberStyles,
# InvariantCulture) is allowlisted by looking at the rest of the statement.
python3 - "$ROOT" <<'PY'
import re
import sys
from pathlib import Path

root = Path(sys.argv[1])
comment = re.compile(r"^\s*(///|//)")
to_case = re.compile(r"\.To(Lower|Upper)\s*\(")
to_case_ok = re.compile(r"To(Lower|Upper)Invariant")
starts = re.compile(r"\.(StartsWith|EndsWith|IndexOf)\s*\(")
starts_char = re.compile(r"\.(StartsWith|EndsWith|IndexOf)\s*\(\s*'")
ordinal = re.compile(r"StringComparison\.(Ordinal|OrdinalIgnoreCase)")
parse = re.compile(
    r"\b(?:int|long|double|float|decimal|byte|short|uint|ulong|sbyte|ushort|DateTime)\.(TryParse|Parse)\s*\("
)
parse_ok = re.compile(r"InvariantCulture|NumberStyles")

hits = []
for path in sorted((root / "src").rglob("*.cs")):
    lines = path.read_text(encoding="utf-8").splitlines()
    for i, line in enumerate(lines):
        if comment.match(line):
            continue
        if to_case.search(line) and not to_case_ok.search(line):
            hits.append(f"{path.relative_to(root)}:{i + 1}:{line.rstrip()}")
            continue
        if starts.search(line) and not starts_char.search(line) and not ordinal.search(line):
            hits.append(f"{path.relative_to(root)}:{i + 1}:{line.rstrip()}")
            continue
        if parse.search(line):
            stmt = [line]
            j = i + 1
            while j < len(lines) and ";" not in "".join(stmt):
                stmt.append(lines[j])
                j += 1
            if not parse_ok.search("\n".join(stmt)):
                hits.append(f"{path.relative_to(root)}:{i + 1}:{line.rstrip()}")

if hits:
    print("culture-sensitive Parse/ToLower/StartsWith (use Invariant/Ordinal/NumberStyles):", file=sys.stderr)
    print("\n".join(hits), file=sys.stderr)
    sys.exit(1)
PY

# Checklist §1: existing C# translations of the 18 float→i64 sites must go
# through TruncToI64 (or TruncToUsize for easing.rs's as i64 as usize).
# Sites whose effect/eval files do not exist yet must not fail the build.
python3 - "$ROOT" <<'PY'
import re
import sys
from pathlib import Path

root = Path(sys.argv[1])

# (relative cs path, markers that the site has been translated, required helper)
SITES = [
    ("src/Ttfx/Utils/Easing.cs", ("SequenceEaser", "eased_value"), "TruncToUsize|TruncToI64"),
    ("src/Ttfx/Utils/Graphics.cs", ("ShiftColorTowards",), "TruncToI64"),
    ("src/Ttfx/Utils/Geometry.cs", ("FindCoordsInCircle",), "TruncToI64"),
    ("src/Ttfx/Effects/Colorshift.cs", ("direction_index", "ColorShift"), "TruncToI64"),
    ("src/Ttfx/Effects/ColorShift.cs", ("direction_index", "ColorShift"), "TruncToI64"),
    ("src/Ttfx/Effects/OrbittingVolley.cs", ("parent_progress", "volley_size", "ParentProgress"), "TruncToI64"),
    ("src/Ttfx/Effects/Matrix.cs", ("characters.len", "0.1"), "TruncToI64"),
    ("src/Ttfx/Effects/BinaryPath.cs", ("active_binary_groups", "0.2"), "TruncToI64"),
    ("src/Ttfx/Effects/Spotlights.cs", ("smallest_dimension", "SmallestDimension"), "TruncToI64"),
    ("src/Ttfx/Effects/BouncyBalls.cs", ("uniform(1.0, 1.5)", "Uniform(1.0, 1.5)"), "TruncToI64"),
    ("src/Ttfx/Effects/RandomSequence.cs", ("speed * input_len", "input_len"), "TruncToI64"),
    ("src/Ttfx/Effects/Spray.cs", ("spray_volume", "SprayVolume"), "TruncToI64"),
    ("src/Ttfx/Effects/ErrorCorrect.cs", ("error_pairs", "ErrorPairs"), "TruncToI64"),
    ("src/Ttfx/Effects/Fireworks.cs", ("launch_delay", "LaunchDelay"), "TruncToI64"),
]

hits = []
for rel, markers, require in SITES:
    path = root / rel
    if not path.is_file():
        continue
    text = path.read_text(encoding="utf-8")
    if not any(m in text for m in markers):
        continue
    if re.search(require, text) is None:
        hits.append(f"{rel}: translated checklist §1 site must use {require}")

if hits:
    print("checklist §1 TruncToI64 missing:", file=sys.stderr)
    print("\n".join(hits), file=sys.stderr)
    sys.exit(1)
PY

dotnet run --project tests/Ttfx.Tests -c Release --no-launch-profile
